{
 "name": "phrases_v1",
 "version": 1,
 "language": "en",
 "about": "Spoken-command prompts for the ASR + PhraseGrammar tests (android/.../PhraseGrammar.kt). Not personal: the prompts only, no audio. Used by extractor/guided_session.py (block 'phrases'); reusable by the grammar tests and the phone test agent.",
 "expect_format": "list of commands in the order said: OpenApp(<app label>) | Nav(<Vocab phrase: go back, go home, scroll down, scroll up, next, the one before, volume up, volume down, pause, play, show notifications, recent apps>) | Tap(<query>) | Timer(<seconds>) | NONE. The expectation is what the user MEANS; the grammar may not handle every case yet (fillers mid-sentence, self-corrections, two commands).",
 "kinds": {
  "clean": "plain command",
  "filler": "filler words around / between the command words",
  "repeat": "hesitations, repeats, cut-off words",
  "correction": "self-correction, the last command wins",
  "wake": "wake word / politeness",
  "timer": "timer lengths in number words",
  "two": "two commands in one breath",
  "chatter": "talk that must do nothing",
  "free": "the user's own wording; transcript from ASR"
 },
