<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- HTTP decider (/v1/systemone). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- BLE GATT client (BleFeatureSource). Android 12+: SCAN (not used for location) and CONNECT, granted at run time
         from MainActivity. Android 11 (minSdk 30): the legacy permissions, and location for scanning. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- To name the foreground app and find the launcher (screen kind "home screen"). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- [phone-mic] Sound source "Phone mic" / "USB mic" (audio/PhoneMicSource.kt): the mic, asked for at run time
         from the settings screen; the foreground service of type microphone that lets Canti listen while another app
         is on screen (Android 14: FOREGROUND_SERVICE_MICROPHONE); its notification (Android 13+ asks for it). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "set a timer for 5 minutes" (AlarmClock.ACTION_SET_TIMER) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Phrase window speech (AndroidPhraseRecognizer): find the phone's recognition service; the timer app. -->
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.SET_TIMER" /></intent>
    </queries>
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_on"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <!-- The Flutter UI (../ui, add-to-app). The configChanges list is the one Flutter recommends: the engine handles
             these itself instead of the activity being recreated. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- The launcher entry: two aliases of MainActivity, one per icon (res/mipmap-anydpi-v26/ic_launcher_on|off,
             generated by brand/tools/stipple.py). Exactly one is enabled; LauncherIcon.kt switches them when the
             device link changes (paired and connected: on). MainActivity itself stays exported for `am start -n`. -->
        <activity-alias
            android:name=".LauncherOn"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_on"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherOff"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_off"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The native settings screen from before Flutter, opened from the Flutter screen's "Legacy settings". -->
        <activity
            android:name=".LegacySettingsActivity"
            android:exported="false"
            android:label="Canti settings" />

        <service
            android:name=".VoxService"
            android:exported="false"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/vox_accessibility" />
        </service>

        <!-- [phone-mic] Keeps the mic usable in the background while the phone/USB mic source is selected
             (its notification is audio/CantiNotification). Holds no audio itself. -->
        <service
            android:name=".audio.MicListenService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <activity
            android:name=".audio.SourceChooserActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="ai.vox.companion.sourcechooser"
            android:label="Sound source"
            android:theme="@android:style/Theme.Material.Light.Dialog" />

        <receiver
            android:name=".audio.CantiNotification$Receiver"
            android:exported="false" />

        <!-- Debug feature source over broadcast. Only senders holding DUMP (adb shell, system) can deliver,
             and the receiver ignores everything unless the build is debuggable. -->
        <receiver
            android:name=".DebugBroadcastReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="ai.vox.companion.DEBUG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
